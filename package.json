{
  "name": "icbe",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ]
  },
  "scripts": {
    "build:apps": "bun run -F './apps/*' build",
    "build:userscript": "bun run --cwd ./packages/colorproven-userscript build",
    "format": "biome check --write --diagnostic-level=error",
    "lint": "biome check",
    "test": "bun test",
    "typegen": "bun run --cwd ./apps/icbe typegen"
  },
  "overrides": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@emnapi/runtime": "1.11.3",
    "@jridgewell/trace-mapping": "0.3.31",
    "esbuild": "0.28.2",
    "js-yaml": "npm:neoyaml@0.2.0",
    "lightningcss": "1.33.0",
    "semver": "7.8.5",
    "sharp": "0.35.5",
    "unstorage": "2.0.0-beta.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@gameroman/config": "0.3.0",
    "typescript": "7.0.2"
  }
}
