{
  "name": "icbe",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ]
  },
  "scripts": {
    "build:apps": "bun run -F './apps/*' build",
    "build:userscript": "bun run --cwd ./packages/colorproven-userscript build",
    "format": "biome check --write",
    "lint": "biome check",
    "test": "bun test",
    "typegen": "bun run --cwd ./apps/icbe typegen"
  },
  "overrides": {
    "@cloudflare/vite-plugin": "1.54.1",
    "@jridgewell/trace-mapping": "0.3.31",
    "esbuild": "0.28.2",
    "js-yaml": "npm:neoyaml@0.1.2",
    "semver": "7.8.5",
    "unstorage": "2.0.0-alpha.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@gameroman/config": "0.2.9",
    "typescript": "7.0.2"
  }
}
