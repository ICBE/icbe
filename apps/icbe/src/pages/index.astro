---
import PageShell from "#components/PageShell.astro";
import IconLink from "#components/ui/IconLink.astro";
import TextLink from "#components/ui/TextLink.astro";
import IconDiscord from "#icon/Discord";
import IconGitHub from "#icon/GitHub";
import Layout from "#layout";

const title = "Infinite Craft Base Elements";
const description = "Infinite Craft Base Elements";

export const prerender = true;
---

<Layout {title} {description}>
  <PageShell>
    <div class="flex flex-1 items-center justify-center gap-6">
      <div class="flex flex-column flex-1 items-center justify-center gap-6">
        <IconLink icon={<IconDiscord />} href="/discord" external />
        <IconLink icon={<IconGitHub />} href="/github" external />
      </div>
      <TextLink label="Userscript" href="/usercript" />
      <TextLink label="History" href="/history" />
    </div>
  </PageShell>
</Layout>
