---
import Link from "./Link.astro";

interface Props {
  href: string;
  icon: unknown;
  external?: boolean;
}

const { href, icon, external = false } = Astro.props;
---

<Link
  {href}
  {external}
  content={icon}
  class="size-12 text-zinc-500 dark:text-zinc-300 transition-colors hover:text-zinc-700 dark:hover:text-zinc-200"
/>
