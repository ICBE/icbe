---
import Link from "./Link.astro";

interface Props {
  href: string;
  label: string;
  external?: boolean;
}

const { href, label, external = false } = Astro.props;
---

<Link
  {href}
  {external}
  content={label}
  class="rounded-lg bg-zinc-900 px-6 py-2 text-xl font-medium text-white transition-colors hover:bg-zinc-700 dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-200"
/>
